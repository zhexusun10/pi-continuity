{
  "name": "pi-continuity",
  "version": "0.1.0",
  "description": "Pi coding-agent extension that recovers truncated turns, failed streams, empty responses, and terminal tool-call tails through public session boundaries.",
  "type": "module",
  "license": "MIT",
  "author": "Jerry (zhexusun10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhexusun10/pi-continuity.git"
  },
  "bugs": { "url": "https://github.com/zhexusun10/pi-continuity/issues" },
  "homepage": "https://github.com/zhexusun10/pi-continuity#readme",
  "keywords": [
    "pi-package", "pi", "pi-coding-agent", "pi-agent", "pi-extension", "agent-session",
    "coding-agent", "context-management", "harness-resilience", "loop-engineering",
    "stream-recovery", "output-truncation", "tool-calls", "retry"
  ],
  "files": [
    "extensions/", "lib/", "README.md", "CONTRIBUTING.md", "docs/README.zh-CN.md",
    "docs/design.md", "docs/evidence.md", "docs/assets.md", "docs/releasing.md",
    "LICENSE", "CHANGELOG.md"
  ],
  "pi": {
    "extensions": ["./extensions/index.ts"],
    "image": "https://raw.githubusercontent.com/zhexusun10/pi-continuity/main/assets/loop-engineering.png?v=2",
    "video": "https://raw.githubusercontent.com/zhexusun10/pi-continuity/main/assets/demo.mp4"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-agent-core": "1.0.3",
    "@types/node": "22.19.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:load": "node scripts/verify-install.mjs",
    "assets": "python scripts/render-assets.py",
    "prepublishOnly": "npm run check && npm test && npm run verify:load"
  }
}
