{
  "name": "pi-continuity",
  "version": "0.1.0",
  "description": "Robust loop engineering for Pi: preserve progress and recover output truncation, broken streams, and tool-call endings.",
  "type": "module",
  "license": "MIT",
  "author": "Jerry (zhexusun10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhexusun10/pi-continuity.git"
  },
  "bugs": { "url": "https://github.com/zhexusun10/pi-continuity/issues" },
  "homepage": "https://github.com/zhexusun10/pi-continuity#readme",
  "keywords": ["pi-package", "pi", "pi-agent", "pi-extension", "coding-agent", "loop-engineering", "harness-resilience", "recovery", "output-truncation"],
  "files": ["extensions/", "lib/", "README.md", "docs/README.zh-CN.md", "docs/design.md", "docs/evidence.md", "docs/assets.md", "LICENSE", "CHANGELOG.md"],
  "pi": {
    "extensions": ["./extensions/index.ts"],
    "image": "https://raw.githubusercontent.com/zhexusun10/pi-continuity/main/assets/loop-engineering.png?v=2",
    "video": "https://raw.githubusercontent.com/zhexusun10/pi-continuity/main/assets/demo.mp4"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-agent-core": "1.0.1",
    "@types/node": "22.19.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:load": "node scripts/verify-install.mjs",
    "assets": "python scripts/render-assets.py",
    "prepublishOnly": "npm run check && npm test"
  }
}
